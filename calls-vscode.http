@baseUrl = http://localhost:5111

# Login for bimuser01
# @name login 
POST http://localhost:8080/realms/bimevents/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

grant_type=password&username=bimuser01&password=bimuser01!&client_id=example-client&scope=openid profile email

### 

@authToken = {{login.response.body.access_token}}

# Login for bimuser02
# @name login
POST http://localhost:8080/realms/bimevents/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

grant_type=password&username=bimuser02&password=bimuser02!&client_id=example-client&scope=openid profile email

### 

@authToken = {{login.response.body.access_token}}

# Create a new building plan
# @name createPlan
POST {{baseUrl}}/plan/create
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "planName": "My New Building Plan"
}

### 

@planId = {{createPlan.response.body.planId}}

# Update Roof Specification
# @name updateRoofSpecification
POST {{baseUrl}}/plan/updateroofspecification
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "planId": "{{planId}}",
  "roofSpecification": {
    "snowLoadKiloNewtonPerM2": 1,
    "windUpliftKiloNewtonPerM2": 1
  }
}

###

# Update Roof Specification
# @name updateRoofSpecification
POST {{baseUrl}}/plan/updateroofspecification
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "planId": "{{planId}}",
  "roofSpecification": {
    "snowLoadKiloNewtonPerM2": 1.2,
    "windUpliftKiloNewtonPerM2": 1.5
  }
}

###

# Get Plan
# @name getPlan
GET {{baseUrl}}/plan/{{planId}}
Authorization: Bearer {{authToken}}

### 

# Get Plan Activity
GET {{baseUrl}}/plan/activity/{{planId}}
Authorization: Bearer {{authToken}}

###