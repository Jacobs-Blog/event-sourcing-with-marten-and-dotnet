%}

### Create plan
POST http://localhost:5111/plan/create
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "planName": "My New Building Plan"
}

> {%
    client.global.set("planId", response.body.planId);
%}

### Update Roof Specification
POST http://localhost:5111/plan/updateroofspecification
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "planId": "{{planId}}",
  "roofSpecification": {
    "snowLoadKiloNewtonPerM2": 1,
    "windUpliftKiloNewtonPerM2": 1
  }
}

### Update Roof Specification
POST http://localhost:5111/plan/updateroofspecification
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "planId": "{{planId}}",
  "roofSpecification": {
    "snowLoadKiloNewtonPerM2": 1.2,
    "windUpliftKiloNewtonPerM2": 1.5
  }
}

### Get Plan
GET http://localhost:5111/plan/{{planId}}

### Get Plan Activity
GET http://localhost:5111/plan/activity/{{planId}}

### Get All Plans
GET http://localhost:5111/plan/all

### Get Plan Activity for specific plan
GET http://localhost:5111/plan/activity/97be51f4-b5fd-4af7-b596-d8878f68baed

### Get All User Activities
GET http://localhost:5111/useractivity

### Get Specific User Activity
GET http://localhost:5111/useractivity/e173e3ed-416c-4e88-82b2-e06b6ce841e7
